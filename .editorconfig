# Editor settings read by IntelliJ and most editors; the Java format itself is checked by Spotless (.spotless/eclipse-formatter.prefs)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
max_line_length = 160

[*.md]
trim_trailing_whitespace = false
